# Nemotron / NIM: one key is enough — the same NVIDIA API key works everywhere.
NVIDIA_API_KEY=your_key_here
# Optional duplicate for nvcr.io; if you leave this out, run_nim_*.sh uses NVIDIA_API_KEY.
# NGC_API_KEY=your_key_here
USE_LOCAL_NIM=true
GX10_IP=localhost
# Fleet size; master leader assigns work, workers do not self-claim.
NUM_LEADERS=1
NUM_WORKERS=12
FLEET_MASTER_ONLY=true
ALL_AGENTS_LLM=false
# Keep false in master mode — cooperative reservations + yield can freeze the fleet.
COOPERATIVE_PATHING=false
# Continuous autonomous fleet (Parts→Assembly→QA→Shipping cycle). Chat UI removed.
FACTORYMIND_AUTO_START=true
# Refill when queue drops below low-water; each refill adds this many legs.
FACTORYMIND_FLEET_LOW_WATER=36
FACTORYMIND_FLEET_REFILL_BATCH=48
AGENTS_USE_MOCK=false
# Chat commands are interpreted by the LLM (exact per-station counts); regex is fallback only.
USE_LLM_TASK_INTERPRETER=true
NEMOTRON_TIMEOUT_SECONDS=3.0
LEADER_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
WORKER_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
STRATEGIST_MODEL=nvidia/llama-3_3-nemotron-super-49b-v1_5

# NemoClaw / OpenClaw runtime: gates every autonomous leader decision and
# every outbound LLM call against scripts/nemoclaw_policy.yaml.
#   false (default) -> log every decision to logs/nemoclaw.log, never refuse
#   true            -> refuse denied actions; agents fall back to mock
NEMOCLAW_ENFORCE=false

# Web viewer: JSON publish interval (seconds). When sim is running, ACTIVE is used (~60 Hz).
FACTORYMIND_WEB_PUBLISH_DT=0.12
FACTORYMIND_WEB_PUBLISH_DT_ACTIVE=0.016


