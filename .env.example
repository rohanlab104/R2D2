NVIDIA_API_KEY=your_key_here
USE_LOCAL_NIM=true
GX10_IP=localhost
AGENTS_USE_MOCK=false
ALL_AGENTS_LLM=true
NEMOTRON_TIMEOUT_SECONDS=3.0
LEADER_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
WORKER_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
STRATEGIST_MODEL=nvidia/llama-3_3-nemotron-super-49b-v1_5

# NemoClaw / OpenClaw runtime: gates every autonomous leader decision and
# every outbound LLM call against scripts/nemoclaw_policy.yaml.
#   false (default) -> log every decision to logs/nemoclaw.log, never refuse
#   true            -> refuse denied actions; agents fall back to mock
NEMOCLAW_ENFORCE=false


